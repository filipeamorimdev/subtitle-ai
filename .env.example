# Runtime
SUBTITLE_AI_CONFIG_DIR=./config
SUBTITLE_AI_LOG_LEVEL=INFO
SUBTITLE_AI_HOST=0.0.0.0
SUBTITLE_AI_PORT=6768
# Optional override. When unset, media roots are auto-discovered from container
# mounts under /data and /media (from Docker volume mounts).
# SUBTITLE_AI_MEDIA_ROOTS=/data/movies,/data/tv
# Optional. Local Whisper CPU threads. 0 = half the cores (leaves headroom for the UI).
# SUBTITLE_AI_WHISPER_CPU_THREADS=2
# Optional. CPU-only dub watchdog and Chatterbox model recycling.
# SUBTITLE_AI_DUB_MAX_RUNTIME_HOURS=12
# SUBTITLE_AI_CHATTERBOX_RECYCLE_CUES=50
# SUBTITLE_AI_CHATTERBOX_MAX_CUE_SECONDS=600
# Optional. Write per-task debug traces under {CONFIG_DIR}/debug (independent of log level).
# SUBTITLE_AI_DEBUG_TRACE=false

# Optional HTTP Basic auth (leave unset for trusted LAN)
# SUBTITLE_AI_AUTH_USERNAME=admin
# SUBTITLE_AI_AUTH_PASSWORD=
# Or require a reverse-proxy identity header (Authelia/Authentik):
# SUBTITLE_AI_AUTH_FORWARD_HEADER=Remote-User
