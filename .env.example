# Runtime
SUBTITLE_AI_CONFIG_DIR=./config
SUBTITLE_AI_LOG_LEVEL=INFO
SUBTITLE_AI_HOST=0.0.0.0
SUBTITLE_AI_PORT=6768
# Optional override. When unset, media roots are auto-discovered from container
# mounts under /data and /media (from Docker volume mounts).
# SUBTITLE_AI_MEDIA_ROOTS=/data/movies,/data/tv

# Optional overrides (prefer configuring secrets in the UI)
# SUBTITLE_AI_FRONTEND_DIST=./frontend/dist
